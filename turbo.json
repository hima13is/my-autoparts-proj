{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/e2e/**", "!**/__tests__/**"],
      "outputs": [".next/**", "!.next/cache/**", ".medusa/server/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "MEDUSA_BACKEND_URL"]
    },
    "dev": { "cache": false, "persistent": true },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true },
    "lint": { "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "outputs": ["coverage/**"] }
  }
}
