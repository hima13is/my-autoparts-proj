{
  "name": "@autoparts/ui",
  "version": "0.0.0",
  "private": true,
  "description": "FitGaadi design system: brand tokens, logo and React components.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/theme.css",
    "./tokens": "./src/tokens.ts",
    "./assets/*": "./assets/*",
    "./fixtures": "./src/fixtures/index.ts"
  },
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build:storybook": "storybook build --output-dir storybook-static",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:visual": "playwright test",
    "logo": "node scripts/build-logo.mjs",
    "brand-sheet": "node scripts/export-brand-sheet.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@autoparts/shared": "workspace:*",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-storybook": "10.6.3",
    "jsdom": "30.1.3",
    "opentype.js": "2.0.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
