# ---------------------------------------------------------------------------
# Master list of every environment variable the project uses.
# NAMES ONLY: never put real values in this file or commit a real .env.
#
# Local dev:  copy apps/backend/.env.template    -> apps/backend/.env
#             copy apps/storefront/.env.template -> apps/storefront/.env.local
# Staging/production values live in Railway (backend) and Vercel (storefront).
# Variables marked [Phase N] are not used yet.
# ---------------------------------------------------------------------------

# --- Backend (apps/backend) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autoparts
REDIS_URL=redis://localhost:6379
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

MEILISEARCH_HOST=http://localhost:7700          # [Phase 2]
MEILISEARCH_ADMIN_KEY=                          # [Phase 2]
R2_ACCOUNT_ID=                                  # [Phase 2] product images
R2_ACCESS_KEY_ID=                               # [Phase 2]
R2_SECRET_ACCESS_KEY=                           # [Phase 2]
R2_BUCKET=                                      # [Phase 2]
SHIPROCKET_EMAIL=                               # [Phase 2] PIN serviceability
SHIPROCKET_PASSWORD=                            # [Phase 2]
RAZORPAY_KEY_ID=                                # [Phase 3] test keys outside production
RAZORPAY_KEY_SECRET=                            # [Phase 3]
RAZORPAY_WEBHOOK_SECRET=                        # [Phase 3]
MSG91_AUTH_KEY=                                 # [Phase 3] OTP/SMS (needs DLT)
MSG91_OTP_TEMPLATE_ID=                          # [Phase 3]
RESEND_API_KEY=                                 # [Phase 3] email
SELLER_GSTIN=                                   # [Phase 3] invoices
SELLER_STATE_CODE=                              # [Phase 3] CGST/SGST vs IGST
WHATSAPP_API_KEY=                               # [Phase 4+]
SENTRY_DSN=                                     # [Phase 0 staging]

# --- Storefront (apps/storefront) ---
MEDUSA_BACKEND_URL=http://localhost:9000        # server-only
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=             # [Phase 2]
NEXT_PUBLIC_MEILISEARCH_HOST=                   # [Phase 2]
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=             # [Phase 2] search-only key
NEXT_PUBLIC_RAZORPAY_KEY_ID=                    # [Phase 3]
NEXT_PUBLIC_POSTHOG_KEY=                        # [Phase 5]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
