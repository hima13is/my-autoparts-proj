{
  "name": "@autoparts/backend",
  "version": "0.0.1",
  "description": "Commerce backend (Medusa v2) for the car accessories store.",
  "author": "Himanshu Kumar",
  "license": "UNLICENSED",
  "keywords": [
    "medusa",
    "ecommerce",
    "india",
    "car-accessories"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "start:prod": "cd .medusa/server && medusa db:migrate && medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "medusa db:migrate",
    "test": "pnpm run test:unit",
    "test:unit": "cross-env TEST_TYPE=unit cross-env NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http cross-env NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules cross-env NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.3",
    "@medusajs/admin-shared": "2.22.3",
    "@medusajs/caching": "2.22.3",
    "@medusajs/cli": "2.22.3",
    "@medusajs/dashboard": "2.22.3",
    "@medusajs/draft-order": "2.22.3",
    "@medusajs/framework": "2.22.3",
    "@medusajs/medusa": "2.22.3",
    "@medusajs/ui": "4.2.10",
    "@sentry/node": "11.8.0",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.3",
    "@medusajs/test-utils": "2.22.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
