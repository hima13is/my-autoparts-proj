{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/prototype",
        "http://localhost:3100/prototype/c/seat-covers",
        "http://localhost:3100/prototype/p/leatherette-seat-cover-black",
        "http://localhost:3100/prototype/cart"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
